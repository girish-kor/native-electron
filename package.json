{
  "name": "native-electron",
  "version": "0.1.0",
  "private": true,
  "main": "native/index.js",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "test": "vitest run",
    "electron:dev": "concurrently -k -s first \"vite\" \"wait-on tcp:5173 && electron electron/main.js\"",
    "electron:build": "vite build && electron-builder --config electron-builder.yml",
    "native:start": "expo start",
    "native:android": "expo start --android",
    "native:ios": "expo start --ios"
  },
  "dependencies": {
    "@expo/metro-runtime": "~3.2.3",
    "expo": "~57.0.14",
    "nativewind": "4.0.36",
    "react": "18.2.0",
    "react-dom": "18.2.0",
    "react-native": "0.74.5",
    "react-native-reanimated": "~3.10.1",
    "react-native-safe-area-context": "4.10.5",
    "react-native-web": "~0.19.10"
  },
  "overrides": {
    "react-native": "0.74.5"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@eslint/js": "^9.9.1",
    "@react-native/js-polyfills": "0.74.87",
    "@testing-library/jest-dom": "^6.5.0",
    "@testing-library/react": "^16.0.1",
    "@vitejs/plugin-react": "^6.0.5",
    "autoprefixer": "^10.4.20",
    "babel-preset-expo": "^11.0.15",
    "concurrently": "^9.0.1",
    "electron": "^39.8.10",
    "electron-builder": "^26.15.3",
    "eslint": "^9.9.1",
    "eslint-plugin-react": "^7.35.0",
    "eslint-plugin-react-hooks": "^5.1.0-rc-fb9a90fa48-20240614",
    "globals": "^15.9.0",
    "jsdom": "^25.0.0",
    "metro": "0.80.12",
    "postcss": "^8.4.45",
    "tailwindcss": "^3.4.19",
    "vite": "^8.2.1",
    "vitest": "^4.1.11",
    "wait-on": "^8.0.0"
  }
}
